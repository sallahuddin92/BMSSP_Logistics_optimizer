{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
  "configurePresets": [
    {"name": "debug", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/../bmssp-native-build/debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "CMAKE_EXPORT_COMPILE_COMMANDS": "ON", "BUILD_TESTING": "ON"}},
    {"name": "release", "inherits": "debug", "binaryDir": "${sourceDir}/../bmssp-native-build/release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "sanitizers", "inherits": "debug", "binaryDir": "${sourceDir}/../bmssp-native-build/sanitizers", "cacheVariables": {"BMSSP_SANITIZERS": "ON"}}
  ],
  "buildPresets": [{"name": "debug", "configurePreset": "debug"}, {"name": "release", "configurePreset": "release"}, {"name": "sanitizers", "configurePreset": "sanitizers"}],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "sanitizers", "configurePreset": "sanitizers", "output": {"outputOnFailure": true}}
  ]
}
