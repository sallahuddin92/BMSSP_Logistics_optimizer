# Test-only derivation of the exact production translation unit. The library,
# bindings, CLI and timing binaries never compile these hooks. No Python needed.
file(READ "${CMAKE_SOURCE_DIR}/native/src/bmssp_bounded.cpp" PIVOT_TEST_SOURCE)
function(pivot_test_replace old new)
  string(FIND "${PIVOT_TEST_SOURCE}" "${old}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Unsupported FindPivots source for test hook: ${old}")
  endif()
  string(REPLACE "${old}" "${new}" PIVOT_TEST_SOURCE "${PIVOT_TEST_SOURCE}")
  set(PIVOT_TEST_SOURCE "${PIVOT_TEST_SOURCE}" PARENT_SCOPE)
endfunction()
pivot_test_replace("    ProfileScope scope(ProfilePart::pivots);" "    ProfileScope scope(ProfilePart::pivots);\n    pivot_test::Scope pivot_trace(*this,k_,bound,frontier);")
pivot_test_replace("        if (visited.size() > limit) {" "        pivot_trace.round(current,next,visited);\n        if (visited.size() > limit) {")
pivot_test_replace("            return {frontier, std::move(visited), true};" "            return pivot_trace.finish({frontier, std::move(visited), true});")
pivot_test_replace("    return {std::move(pivots), std::move(visited), false};" "    return pivot_trace.finish({std::move(pivots), std::move(visited), false});")
file(WRITE "${CMAKE_BINARY_DIR}/pivot_test_bounded.cpp" "#include \"pivot_test_observer.hpp\"\n${PIVOT_TEST_SOURCE}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/native/src/bmssp_bounded.cpp")
add_executable(pivot_tests native/tests/pivot_tests.cpp "${CMAKE_BINARY_DIR}/pivot_test_bounded.cpp")
target_include_directories(pivot_tests PRIVATE native/test_support)
target_link_libraries(pivot_tests PRIVATE bmssp_foundation)
add_test(NAME pivots COMMAND pivot_tests)
set_tests_properties(pivots PROPERTIES TIMEOUT 120)
