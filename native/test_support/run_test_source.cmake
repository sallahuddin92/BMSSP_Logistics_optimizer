# Derive actual and frozen recursion test objects, without a Python dependency.
function(instrument_run input output)
  file(READ "${input}" text)
  foreach(marker IN ITEMS "        auto pulled = data.pull();" "        ++depth_;" "        --depth_;\n        if (child.bound" "    return finish({boundary, std::move(complete)});")
    string(FIND "${text}" "${marker}" found)
    if(found EQUAL -1)
      message(FATAL_ERROR "Unsupported run test source: ${marker}")
    endif()
  endforeach()
  string(REPLACE "        auto pulled = data.pull();" "        auto pulled = data.pull();\n        run_test::pulled(depth_,complete,pulled);" text "${text}")
  string(REPLACE "        ++depth_;" "        run_test::state(*this,level,depth_,0,complete,complete_members,boundary);\n        ++depth_;" text "${text}")
  string(REPLACE "        --depth_;\n        if (child.bound" "        --depth_;\n        run_test::child(depth_,complete,child);\n        run_test::state(*this,level,depth_,1,complete,complete_members,boundary);\n        if (child.bound" text "${text}")
  string(REPLACE "    return finish({boundary, std::move(complete)});" "    run_test::state(*this,level,depth_,2,complete,complete_members,boundary);\n    return finish({boundary, std::move(complete)});" text "${text}")
  file(WRITE "${output}" "#include \"run_test_observer.hpp\"\n${text}")
endfunction()
instrument_run("${CMAKE_SOURCE_DIR}/native/src/bmssp_bounded.cpp" "${CMAKE_BINARY_DIR}/run_test_bounded.cpp")
instrument_run("${CMAKE_SOURCE_DIR}/native/tests/run_task11_reference.cpp" "${CMAKE_BINARY_DIR}/run_test_reference.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/native/src/bmssp_bounded.cpp" "${CMAKE_SOURCE_DIR}/native/tests/run_task11_reference.cpp")
add_executable(recursion_membership_tests native/tests/recursion_membership_tests.cpp "${CMAKE_BINARY_DIR}/run_test_bounded.cpp" "${CMAKE_BINARY_DIR}/run_test_reference.cpp")
target_include_directories(recursion_membership_tests PRIVATE native/test_support native/tests)
target_link_libraries(recursion_membership_tests PRIVATE bmssp_foundation)
add_test(NAME recursion_membership COMMAND recursion_membership_tests)
set_tests_properties(recursion_membership PROPERTIES TIMEOUT 120)
