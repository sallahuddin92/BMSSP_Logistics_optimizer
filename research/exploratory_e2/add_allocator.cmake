set(e2_sources graph reference_dijkstra path_reconstruction symbolic_label degree_reduction bounded_frontier bmssp_bounded bmssp_2025)
set(e2_files)
foreach(part IN LISTS e2_sources)
  if(part STREQUAL bounded_frontier)
    list(APPEND e2_files "${E2_DIAGNOSTIC_SOURCE}")
  else()
    list(APPEND e2_files "${CMAKE_SOURCE_DIR}/native/src/${part}.cpp")
  endif()
endforeach()
add_library(e2_allocator_core STATIC ${e2_files})
target_include_directories(e2_allocator_core PUBLIC "${CMAKE_SOURCE_DIR}/native/include" "${CMAKE_CURRENT_LIST_DIR}")
target_link_libraries(e2_allocator_core PUBLIC bmssp_options Threads::Threads)
set_target_properties(e2_allocator_core PROPERTIES CXX_EXTENSIONS OFF POSITION_INDEPENDENT_CODE ON)
add_executable(e2_allocator "${CMAKE_CURRENT_LIST_DIR}/allocator.cpp")
target_link_libraries(e2_allocator PRIVATE e2_allocator_core)
set_target_properties(e2_allocator PROPERTIES CXX_EXTENSIONS OFF)
